# Written to .env by demo.sh on first run, with fresh secrets.
REDASH_PORT=5055
ZSQL_PORT=3699

# The zsql release to pull, from github.com/stratasite/0sql/releases.
# 0.6.0 runs everything the demo does. Ad-hoc calculated fields in a query
# line, such as `Cost Share = [Wholesale Cost]@m / [Net Paid]@m`, need 0.6.1.
ZSQL_VERSION=0.6.0

# Redash. REDASH_SECRET_KEY encrypts data source settings: changing it later
# means `docker compose down -v && ./demo.sh`.
REDASH_REDIS_URL=redis://redis:6379/0
REDASH_DATABASE_URL=postgresql://postgres:redash@postgres/postgres
POSTGRES_PASSWORD=redash
REDASH_COOKIE_SECRET=change-me
REDASH_SECRET_KEY=change-me
# The data source picker offers every runner Redash ships, 75 of them. This
# narrows it to 0sql plus the SQL warehouses its "…or an existing Redash data
# source" option delegates to. Drop the line to get all of them back.
REDASH_ENABLED_QUERY_RUNNERS=redash.query_runner.pg,redash.query_runner.duckdb,redash.query_runner.big_query,redash.query_runner.snowflake,redash.query_runner.athena,redash.query_runner.databricks,redash.query_runner.mysql

REDASH_LOG_LEVEL=INFO
PYTHONUNBUFFERED=0
